{
  "name": "magpie-aihub",
  "version": "0.4.2",
  "description": "Consumer AIHub group routing, session affinity and bounded failover for Magpie",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./server": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "src",
    "ui",
    "README.md",
    "LICENSE",
    "documentation"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check index.mjs && node --check src/config.mjs && node --check src/api.mjs && node --check src/account.mjs && node --check src/billing.mjs && node --check src/async.mjs && node --check src/router.mjs && node --check src/platforms.mjs && node --check src/errors.mjs && node --check src/telemetry.mjs && node --check src/runtime.mjs && node --check src/proxy.mjs && node --check src/service.mjs && node --check ui/app.js"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abworks-dev/magpie-aihub.git"
  },
  "license": "MIT",
  "keywords": [
    "magpie-plugin",
    "opencode-plugin",
    "aihub",
    "failover"
  ],
  "magpie": {
    "name": "AIHub 自动路由",
    "summary": {
      "zh": "使用自己的 AIHub 账户，按倍率和延迟选组，保持会话并在故障时切换。",
      "en": "Route your own AIHub account with session affinity and bounded failover."
    },
    "maxConcurrency": 8,
    "page": {
      "title": "AIHub routing",
      "titles": {
        "zh": "AIHub 路由"
      },
      "file": "ui/index.html",
      "service": {
        "port": 19871,
        "option": "monitorPort"
      }
    },
    "permissions": [
      "providers:list"
    ],
    "options": {
      "maxMultiplier": 0.16,
      "strategy": "balanced",
      "maxAttempts": 3,
      "poolSize": 4,
      "minBalance": 0,
      "maxKeysPerAccount": 8,
      "models": [],
      "platforms": [
        "openai",
        "deepseek",
        "zhipu",
        "kimi",
        "grok",
        "gemini"
      ],
      "monitorPort": 19871
    },
    "icon": "data:image/png;base64,"
  }
}
